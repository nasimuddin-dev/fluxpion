{
  "schemaVersion": "1.0",
  "id": "veterinary-api",
  "name": "Veterinary API",
  "description": "Requests for the local demo REST server (examples/servers/demo-servers.mjs).",
  "version": 1,
  "variables": [],
  "auth": { "type": "bearer", "token": "{{accessToken}}" },
  "items": [
    {
      "kind": "folder",
      "id": "fld-auth",
      "name": "Authentication",
      "items": [
        {
          "kind": "http",
          "id": "req-token",
          "name": "Get access token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/token",
            "auth": { "type": "none" },
            "body": {
              "type": "form-urlencoded",
              "fields": [
                { "key": "client_id", "value": "{{clientId}}" },
                { "key": "client_secret", "value": "{{clientSecret}}" },
                { "key": "grant_type", "value": "client_credentials" }
              ]
            }
          },
          "testScript": "pm.test('Status code is 200', () => pm.response.to.have.status(200));\npm.environment.set('accessToken', pm.response.json().access_token);",
          "assertions": [{ "type": "status", "expected": 200 }]
        }
      ]
    },
    {
      "kind": "folder",
      "id": "fld-patients",
      "name": "Patients",
      "items": [
        {
          "kind": "http",
          "id": "req-list",
          "name": "List patients",
          "request": { "method": "GET", "url": "{{baseUrl}}/patients", "auth": { "type": "inherit" } },
          "assertions": [
            { "type": "status", "expected": 200 },
            { "type": "exists", "path": "$.items[0].id" },
            { "type": "latency", "max": 1000 }
          ]
        },
        {
          "kind": "http",
          "id": "req-get",
          "name": "Get patient",
          "request": { "method": "GET", "url": "{{baseUrl}}/patients/1", "auth": { "type": "inherit" } },
          "assertions": [{ "type": "status", "expected": 200 }],
          "examples": [
            {
              "id": "ex-patient-found",
              "name": "Patient found",
              "status": 200,
              "statusText": "OK",
              "headers": [{ "key": "content-type", "value": "application/json" }],
              "body": "{\n  \"id\": \"1\",\n  \"name\": \"Rex\",\n  \"species\": \"dog\",\n  \"ownerId\": \"123\"\n}"
            },
            {
              "id": "ex-patient-missing",
              "name": "Patient not found",
              "status": 404,
              "statusText": "Not Found",
              "headers": [{ "key": "content-type", "value": "application/json" }],
              "body": "{\n  \"error\": \"not_found\"\n}",
              "request": { "method": "GET", "url": "{{baseUrl}}/patients/999" }
            }
          ]
        },
        {
          "kind": "http",
          "id": "req-create",
          "name": "Create patient",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/patients",
            "auth": { "type": "inherit" },
            "body": { "type": "json", "content": "{\n  \"name\": \"Biscuit\",\n  \"species\": \"dog\",\n  \"ownerId\": \"123\"\n}" }
          },
          "assertions": [{ "type": "status", "expected": 201 }]
        }
      ]
    },
    {
      "kind": "folder",
      "id": "fld-session",
      "name": "Cookie session",
      "items": [
        {
          "kind": "http",
          "id": "req-session-login",
          "name": "Log in (sets a cookie)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/session/login",
            "auth": { "type": "none" },
            "body": { "type": "json", "content": "{\n  \"username\": \"vet\",\n  \"password\": \"paws\"\n}" }
          },
          "testScript": "pm.test('Redirected to the profile', () => pm.response.to.have.status(200));\npm.test('Session cookie is in the jar', () => pm.expect(pm.cookies.has('vet_session')).to.be.true);"
        },
        {
          "kind": "http",
          "id": "req-session-me",
          "name": "Who am I (uses the cookie)",
          "request": { "method": "GET", "url": "{{baseUrl}}/session/me", "auth": { "type": "none" } },
          "testScript": "pm.test('Logged in by cookie', () => pm.expect(pm.response.json().user).to.equal('vet'));\npm.cookies.jar().get(pm.request.url.toString(), 'clinic', (err, clinic) => pm.test('Clinic cookie', () => pm.expect(clinic).to.equal('north')));"
        },
        {
          "kind": "http",
          "id": "req-session-logout",
          "name": "Log out (expires the cookie)",
          "request": { "method": "POST", "url": "{{baseUrl}}/session/logout", "auth": { "type": "none" } },
          "assertions": [{ "type": "status", "expected": 204 }]
        }
      ]
    },
    {
      "kind": "folder",
      "id": "fld-diag",
      "name": "Diagnostics",
      "items": [
        { "kind": "http", "id": "req-health", "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/health", "auth": { "type": "none" } } },
        { "kind": "http", "id": "req-events", "name": "Server-sent events", "request": { "method": "GET", "url": "{{baseUrl}}/events?count=5", "headers": [{ "key": "Accept", "value": "text/event-stream" }], "auth": { "type": "none" } } },
        { "kind": "http", "id": "req-large", "name": "Large response (10 MB)", "request": { "method": "GET", "url": "{{baseUrl}}/large?mb=10", "auth": { "type": "none" } } }
      ]
    }
  ],
  "updatedAt": "2026-09-26T00:00:00.000Z"
}
