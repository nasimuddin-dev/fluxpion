{
  "schemaVersion": "1.0",
  "folders": [
    "Echo servers",
    "MQTT brokers"
  ],
  "items": [
    {
      "id": "ws-postman-echo",
      "name": "Postman echo (JSON)",
      "folder": "Echo servers",
      "data": {
        "url": "{{wsEcho}}",
        "protocols": "",
        "headers": [],
        "message": "{\n  \"type\": \"greeting\",\n  \"from\": \"{{appName}}\",\n  \"id\": \"{{$guid}}\"\n}",
        "mode": "websocket"
      }
    },
    {
      "id": "ws-echo-org",
      "name": "echo.websocket.org (text)",
      "folder": "Echo servers",
      "data": {
        "url": "{{wsEcho2}}",
        "protocols": "",
        "headers": [],
        "message": "Hello from TestPion",
        "mode": "websocket"
      }
    },
    {
      "id": "mqtt-mosquitto",
      "name": "Mosquitto test broker",
      "folder": "MQTT brokers",
      "data": {
        "url": "mqtt://test.mosquitto.org:1883",
        "protocols": "",
        "headers": [],
        "mode": "mqtt",
        "topic": "testpion/examples/hello",
        "qos": 0,
        "message": "{\n  \"from\": \"{{appName}}\",\n  \"id\": \"{{$guid}}\"\n}",
        "subscriptions": [
          {
            "topic": "testpion/examples/#",
            "qos": 0
          }
        ]
      }
    }
  ]
}
