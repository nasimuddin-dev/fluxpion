      "name": "NumberConversion · NumberConversionSoap",
      "items": [
        {
          "kind": "http",
          "id": "soap-1",
          "name": "NumberToWords",
          "description": "Returns the word corresponding to the positive number passed as parameter. Limited to quadrillions.",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}",
            "params": [],
            "headers": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8",
                "enabled": true
              },
              {
                "key": "SOAPAction",
                "value": "\"\"",
                "enabled": true
              }
            ],
            "body": {
              "type": "xml",
              "content": "<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:tns=\"http://www.dataaccess.com/webservicesserver/\">\n  <soap:Header/>\n  <soap:Body>\n    <tns:NumberToWords>\n      <tns:ubiNum>42</tns:ubiNum>\n    </tns:NumberToWords>\n  </soap:Body>\n</soap:Envelope>"
            },
            "auth": {
              "type": "inherit"
            }
          },
          "assertions": [
            {
              "type": "status",
              "expected": 200
            }
          ],
          "testScript": "// the reply is XML: xml2Json turns it into an object\nconst reply = xml2Json(pm.response.text());\nconst body = reply['soap:Envelope']['soap:Body'];\nconst words = body['m:NumberToWordsResponse']['m:NumberToWordsResult'];\npm.test('42 in words', () => pm.expect(words.trim()).to.equal('forty two'));"
        },
        {
          "kind": "http",
          "id": "soap-2",
          "name": "NumberToDollars",
          "description": "Returns the non-zero dollar amount of the passed number.",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}",
            "params": [],
            "headers": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8",
                "enabled": true
              },
              {
                "key": "SOAPAction",
                "value": "\"\"",
                "enabled": true
              }
            ],
            "body": {
              "type": "xml",
              "content": "<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:tns=\"http://www.dataaccess.com/webservicesserver/\">\n  <soap:Header/>\n  <soap:Body>\n    <tns:NumberToDollars>\n      <tns:dNum>12.5</tns:dNum>\n    </tns:NumberToDollars>\n  </soap:Body>\n</soap:Envelope>"
            },
            "auth": {
              "type": "inherit"
            }
          },
          "assertions": [
            {
              "type": "status",
              "expected": 200
            }
          ],
          "testScript": "pm.test('dollars and cents', () => pm.expect(pm.response.text()).to.include('twelve dollars and fifty cents'));"
        }
      ]
